{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nodetunnel-website",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-07-13",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nodetunnel",
			"database_id": "45073184-26b1-4683-9d99-bcccb6f9af6e",
			"migrations_dir": "migrations"
		}
	],
	// TURNSTILE_SITE_KEY is public. Uncomment to set it here instead of the
	// dashboard -- a `vars` block overrides the dashboard value on deploy.
	// Its secret half is TURNSTILE_SECRET_KEY; set both or neither.
	// "vars": { "TURNSTILE_SITE_KEY": "" },

	// Changing `namespace_id` resets that limiter. `period` must be 10 or 60.
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "SIGNUP_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// Generous: the relay server is a legitimate high-volume caller.
			"name": "RELAY_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 100, "period": 60 }
		}
	]
	// Set RELAY_TOKEN with `wrangler secret put`, or in .dev.vars locally.
}
