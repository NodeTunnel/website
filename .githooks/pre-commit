#!/bin/sh
# Enable once per clone with: git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only | grep -E '^\.dev\.vars$|^\.env$|^\.env\.(?!example|test)|^\.wrangler/' || true)

if [ -n "$blocked" ]; then
	echo "pre-commit: refusing to commit local secret/state files:" >&2
	echo "$blocked" | sed 's/^/  /' >&2
	echo "If this is genuinely intended, re-run with --no-verify." >&2
	exit 1
fi
